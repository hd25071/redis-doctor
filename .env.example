# Copy to .env and fill in. Never commit the real file.

# ---- LLM (OpenAI compatible: DeepSeek / Qwen / vLLM / OpenAI) ----
RD_LLM_PROVIDER=openai_compat
RD_LLM_BASE_URL=https://api.deepseek.com/v1
RD_LLM_API_KEY=
RD_LLM_MODEL=deepseek-chat
RD_LLM_TEMPERATURE=0
RD_LLM_MAX_OUTPUT_TOKENS=2000

# Scripted policy needs no key: `RD_LLM_PROVIDER=reference` is the default and is
# what the committed evaluation table was produced with.

# ---- Diagnosis scope ----
RD_NAMESPACE=demo
RD_REDIS_INSTANCE=demo
RD_BACKEND=sandbox            # sandbox | real

# ---- Safety budgets (enforced per diagnosis) ----
RD_MAX_STEPS=12
RD_MAX_TOOL_CALLS=30
RD_MAX_SECONDS=180
RD_APPROVAL_REQUIRED=true

# ---- Read-only Redis access (real backend) ----
RD_REDIS_ACL_USER=doctor
RD_REDIS_ACL_PASSWORD=

# ---- API ----
RD_WEBHOOK_TOKEN=
RD_ALERT_COOLDOWN_SECONDS=900

# ---- Prometheus ----
RD_PROM_URL=http://127.0.0.1:9090

